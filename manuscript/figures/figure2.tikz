\begin{tikzpicture}[font=\sffamily\fontsize{8.7}{10.5}\selectfont,
  timeaxis/.style={draw=black!75, line width=.8pt}, tick/.style={draw=black!75, line width=.7pt},
  event/.style={font=\sffamily\fontsize{8.7}{10.5}\selectfont, align=center}, >=Latex]
% Reconstructed from the two original timeline cases: all values and event dates preserved.
\node[anchor=west, font=\sffamily\bfseries\fontsize{10}{12}\selectfont] at (0,7.8) {Same contribution, different availability at the payment date};
\node[anchor=west] at (0,7.37) {Common inputs (SAR million): operating cash 85; eligible reserve 5; debt due 100; support 20};
% Panel A: support arrives before day-0 debt service.
\node[anchor=west,font=\bfseries] at (0,6.55) {A. Contribution before payment};
\draw[timeaxis,-{Latex[length=2mm]}] (.26,5.39)--(9.52,5.39);
\foreach \xx/\day in {.5/{-10},3.12/{-5},5.78/{0},8.43/{+5}}{
 \draw[tick] (\xx,5.29)--(\xx,5.49);
 \node[anchor=north] at (\xx,5.22) {day \day};
}
\draw[thick,black!65,-{Latex[length=2mm]}] (3.12,5.71)--(3.12,5.54);
\node[event,anchor=south] at (3.12,5.76) {20 arrives};
\draw[tick] (5.78,5.39)--(5.78,5.73);
\node[event,anchor=south] at (5.78,5.76) {100 due};
\node[anchor=west,align=left] at (10.02,5.81) {Resources at day 0:\\$85+5+20=110$\\\textbf{Remaining liquidity: 10}};
\node[anchor=north,align=center] at (.5,4.96) {Information cutoff\\$t_c=-10$};
% Panel B: support arrives after the due date.
\node[anchor=west,font=\bfseries] at (0,3.8) {B. Contribution after payment};
\draw[timeaxis,-{Latex[length=2mm]}] (.26,2.62)--(9.52,2.62);
\foreach \xx/\day in {.5/{-10},3.12/{-5},5.78/{0},8.43/{+5}}{
 \draw[tick] (\xx,2.52)--(\xx,2.72);
 \node[anchor=north] at (\xx,2.44) {day \day};
}
\draw[thick,black!65,-{Latex[length=2mm]}] (8.43,2.96)--(8.43,2.77);
\node[event,anchor=south] at (8.43,3.01) {20 arrives};
\draw[tick] (5.78,2.62)--(5.78,2.98);
\node[event,anchor=south] at (5.78,3.01) {100 due};
\node[anchor=west,align=left] at (10.02,3.01) {Resources at day 0:\\$85+5+0=90$\\\textbf{Funding requirement: 10}};
\node[anchor=north,align=center] at (.5,2.16) {Same information\\cutoff};
\node[anchor=center,font=\itshape] at (7.04,1.30) {Payment-date boundary $t_d=0$};
\node[anchor=west] at (0,.46) {Review task: identify the dated evidence that supports including or excluding the contribution at day 0.};
\end{tikzpicture}
