\begin{tikzpicture}[>=Latex, node distance=1.0cm, every node/.style={font=\sffamily\fontsize{9}{11}\selectfont}]
\tikzset{outline/.style={draw=black!40, line width=.55pt, rounded corners=1.2pt, fill=white,
       minimum width=3.65cm, minimum height=.72cm, text centered, inner sep=4pt},
       arr/.style={-{Latex[length=2.1mm]}, line width=.75pt, draw=black!70}}
\node[outline] (e) at (0,3.1) {Versioned evidence};
\node[outline] (a) at (4.55,3.1) {Assumption};
\node[outline] (c) at (9.1,3.1) {Calculation};
\node[outline] (m) at (0,1.65) {Methodology provision};
\node[outline] (d) at (4.55,1.65) {Decision record};
\node[outline] (v) at (9.1,1.65) {Structural validator};
\node[outline, minimum width=5.2cm] (r) at (9.1,.16) {Evidential / methodological review};
\draw[arr] (e)--(a);\draw[arr] (a)--(c);
\draw[arr] (e)--(m);\draw[arr] (c)--(v);
\draw[arr] (m)--(d);\draw[arr] (d)--(v);\draw[arr] (v)--(r);
\end{tikzpicture}
