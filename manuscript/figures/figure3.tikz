\begin{tikzpicture}[every node/.style={font=\sffamily\fontsize{8}{9.5}\selectfont}]
\def\xL{3.1}\def\cw{1.75}\def\rh{.60}
\tikzset{cell/.style={draw=black!17,line width=.35pt,minimum height=.59cm,minimum width=1.74cm,inner sep=2pt,align=center}}
\node[anchor=center,align=center,font=\bfseries] at (4.0,4.55) {Full};
\node[anchor=center,align=center,font=\bfseries] at (5.75,4.55) {No ID\\check};
\node[anchor=center,align=center,font=\bfseries] at (7.5,4.55) {No\\reference\\check};
\node[anchor=center,align=center,font=\bfseries] at (9.25,4.55) {No\\cycle\\check};
\node[anchor=center,align=center,font=\bfseries] at (11.0,4.55) {No\\cutoff\\check};
\node[anchor=center,align=center,font=\bfseries] at (12.75,4.55) {No\\digest\\check};
\node[anchor=center,align=center,font=\bfseries] at (14.5,4.55) {No\\metadata\\check};
\foreach \name/\row/\zero in {{Duplicate identifier}/1/1,{Dangling reference}/2/2,{Dependency cycle}/3/3,{Post-cutoff evidence}/4/4,{Source text changed}/5/5,{Decision field missing}/6/6}{
 \pgfmathsetmacro\yy{4.02-\row*.61}
 \node[anchor=east,align=right] at (2.95,\yy) {\name};
 \foreach \col in {0,1,2,3,4,5,6}{
   \pgfmathsetmacro\xx{4.0+\col*1.75}
   \ifnum\col=\zero
     \node[cell,fill=black!8,font=\sffamily\bfseries\fontsize{8}{9.5}\selectfont] at (\xx,\yy) {0/54};
   \else
     \node[cell,fill=white] at (\xx,\yy) {54/54};
   \fi
 }
}
\node[anchor=center,font=\itshape] at (9.25,-.38) {Alerts / controlled perturbations; each cell covers all 54 design cells};
\end{tikzpicture}
